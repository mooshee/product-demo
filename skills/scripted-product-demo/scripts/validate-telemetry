#!/usr/bin/env bash
# Author: Daniel Hallman
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"

if [[ -x "$ROOT_DIR/target/release/validate-telemetry" ]]; then
  exec "$ROOT_DIR/target/release/validate-telemetry" "$@"
fi

if [[ -f "$ROOT_DIR/Cargo.toml" ]]; then
  exec cargo run --release --quiet --manifest-path "$ROOT_DIR/Cargo.toml" --bin validate-telemetry -- "$@"
fi

if [[ -x "${HOME:-}/.local/bin/validate-telemetry" ]]; then
  exec "${HOME}/.local/bin/validate-telemetry" "$@"
fi

echo "validate-telemetry binary not found; build from the repository with: cargo build --release" >&2
exit 69
